@model EMB_Production.Models.Gen_Catagories

@{
    ViewBag.Title = "Delete Category";
}

<style>
    .detail-card {
        background-color: #ffffff;
        padding: 30px;
        border-left: 5px solid #dc3545;
        border-radius: 8px;
        box-shadow: 0 2px 12px rgba(0,0,0,0.1);
        margin-top: 20px;
    }

    .details-header {
        font-size: 1.25rem;
        font-weight: 600;
        background: #dc3545;
        color: #fff;
        padding: 0.75rem 1rem;
        border-radius: 6px 6px 0 0;
        margin: -30px -30px 20px;
    }

    .detail-label {
        font-weight: 600;
        font-size: 0.9rem;
        color: #2c3e50;
    }

    .detail-value {
        font-size: 1rem;
        color: #34495e;
        word-wrap: break-word;
    }

    .hover-highlight .detail-value:hover {
        background-color: #f8f9fa;
        border-radius: 4px;
        padding: 2px 4px;
    }
</style>

<div class="detail-card">
    <div class="details-header">Delete Category</div>

    <div class="alert alert-warning shadow-sm rounded mb-4">
        <strong>Are you sure you want to delete this category?</strong>
        <p class="mb-0">This action cannot be undone.</p>
    </div>

    <div class="row gy-3 hover-highlight">
        <!-- Brand -->
        <div class="col-md-3">
            <div class="detail-label">Brand</div>
            <div class="detail-value">
                @(Model.Gen_Brands?.BrandName ?? "(none)")
            </div>
        </div>

        <!-- Branch -->
        <div class="col-md-3">
            <div class="detail-label">Branch</div>
            <div class="detail-value">
                @(Model.Branches?.Name ?? "(none)")
            </div>
        </div>

        <!-- Scalar fields -->
        @foreach (var prop in ViewData.ModelMetadata.Properties
            .Where(p => p.ShowForDisplay
                     && p.PropertyName != nameof(Model.Id)
                     && p.PropertyName != nameof(Model.Gen_Brands)
                     && p.PropertyName != nameof(Model.Gen_Products)
                     && p.PropertyName != nameof(Model.Branches)))
        {
            <div class="col-md-3">
                <div class="detail-label">@prop.GetDisplayName()</div>
                <div class="detail-value">
                    @{
                        var val = prop.Model;
                        if (val is DateTime dt)
                        {
                            @dt.ToString("yyyy-MM-dd HH:mm")
                        }
                        else
                        {
                            @val
                        }
                    }
                </div>
            </div>
        }
    </div>

    <div class="mt-4 d-flex justify-content-center">
        @using (Html.BeginForm())
        {
            @Html.AntiForgeryToken()
            <input type="submit" value="Confirm Delete" class="btn btn-danger me-3" />
            @Html.ActionLink("Cancel", "Index", null, new { @class = "btn btn-outline-secondary" })
        }
    </div>
</div>

@section Scripts {
    <script>
        $(function () {
            $('.detail-value').hover(
                function () { $(this).addClass('bg-light rounded'); },
                function () { $(this).removeClass('bg-light rounded'); }
            );
        });
    </script>
}
