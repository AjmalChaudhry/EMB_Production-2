@model EMB_Production.Models.Gen_Brands

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Delete Brand";
}

<style>
    .detail-card {
        background: #fff;
        border-left: 5px solid #dc3545;
        border-radius: 8px;
        padding: 2rem;
        box-shadow: 0 2px 12px rgba(0,0,0,0.1);
        margin-top: 2rem;
    }

    .details-header {
        font-size: 1.25rem;
        font-weight: 600;
        background: #dc3545;
        color: #fff;
        padding: 0.75rem 1rem;
        border-radius: 6px 6px 0 0;
        margin: -1.5rem -1.5rem 1rem;
    }

    .detail-label {
        font-weight: 600;
        font-size: .95rem;
        color: #2c3e50;
    }

    .detail-value {
        font-size: 1rem;
        color: #343a40;
    }

    .confirm-actions .btn {
        min-width: 120px;
    }
</style>

<div class="container-fluid py-4">
    <div class="detail-card">
        <div class="details-header">Delete Brand</div>

        <div class="alert alert-warning text-center shadow-sm">
            <strong>Are you sure you want to delete this brand?</strong><br />
            This action <u>cannot</u> be undone.
        </div>

        <div class="row g-4">
            <!-- Branch -->
            <div class="col-md-4">
                <div class="detail-label">Branch</div>
                <div class="detail-value">
                    @(Model.Branches?.Name ?? "(none)")
                </div>
            </div>

            <!-- Scalar props -->
            @foreach (var p in ViewData.ModelMetadata.Properties
                        .Where(x => x.ShowForDisplay
                                 && x.PropertyName != "Id"
                                 && x.PropertyName != "Branches"
                                 && x.PropertyName != "Gen_Catagories"
                                 && x.PropertyName != "Gen_Machines"))
            {
                <div class="col-md-4">
                    <div class="detail-label">@p.GetDisplayName()</div>
                    <div class="detail-value">
                        @{
                            var v = p.Model;
                            if (v is DateTime dt)
                            {
                                @dt.ToString("yyyy-MM-dd HH:mm:ss")
                            }
                            else
                            {
                                @(v ?? "(none)")
                            }
                        }
                    </div>
                </div>
            }

            <!-- Categories table -->
            <div class="col-3">
                <div class="detail-label">Categories (@Model.Gen_Catagories.Count)</div>
                <div class="table-responsive detail-value p-0">
                    @if (Model.Gen_Catagories.Any())
                    {
                        <table class="table table-sm table-striped mb-0">
                            <thead>
                                <tr><th>ID</th><th>Name</th><th>Code</th></tr>
                            </thead>
                            <tbody>
                                @foreach (var c in Model.Gen_Catagories.OrderBy(c => c.Id))
                                {
                                    <tr>
                                        <td class="align-middle">@c.Id</td>
                                        <td class="align-middle">@c.Name</td>
                                        <td class="align-middle">@c.Code</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                    else
                    {
                        <em>(no categories)</em>
                    }
                </div>
            </div>

            <!-- Machines table -->
            <div class="col-2">
                <div class="detail-label">Machines (@Model.Gen_Machines.Count)</div>
                <div class="table-responsive detail-value p-0">
                    @if (Model.Gen_Machines.Any())
                    {
                        <table class="table table-sm table-striped mb-0">
                            <thead>
                                <tr><th>ID</th><th>Code</th></tr>
                            </thead>
                            <tbody>
                                @foreach (var m in Model.Gen_Machines.OrderBy(m => m.Id))
                                {
                                    <tr>
                                        <td class="align-middle">@m.Id</td>
                                        <td class="align-middle">@m.Code</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                    else
                    {
                        <em>(no machines)</em>
                    }
                </div>
            </div>
        </div>

        @using (Html.BeginForm("Delete", "Gen_Brands", FormMethod.Post))
        {
            @Html.AntiForgeryToken()
            <div class="mt-4 d-flex justify-content-center confirm-actions">
                <button type="submit" class="btn btn-danger me-3">
                    <i class="bi bi-trash-fill me-1"></i> Confirm Delete
                </button>
                <a href="@Url.Action("Index","Gen_Brands")"
                   class="btn btn-outline-secondary">
                    <i class="bi bi-arrow-left me-1"></i> Cancel
                </a>
            </div>
        }
    </div>
</div>

@section Scripts {
    <script>
    // highlight values on hover
    $('.detail-value').hover(
      function(){ $(this).addClass('bg-light rounded'); },
      function(){ $(this).removeClass('bg-light rounded'); }
    );
    </script>
}
