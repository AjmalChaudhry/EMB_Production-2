@model EMB_Production.ViewModels.JobOrdersPageViewModel
@using PagedList.Mvc
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    var currentFilter = Model.Search ?? "";
    var activeFilter = Model.ActiveFilter ?? "";
    bool showCreate = Model.ShowCreate;
    bool showEdit = Model.ShowEdit;
    int? editId = Model.EditId;
}

<div class="container-fluid py-4">
    <!-- TOOLBAR -->
    <div class="d-flex align-items-center justify-content-between mb-3 bg-primary text-white p-3 rounded">
        <h2 class="mb-0">Job Orders</h2>
        <div class="d-flex align-items-center">
            @if (showEdit)
            {
                <a class="btn btn-warning btn-sm me-3"
                   href="@Url.Action("Index", new { showEdit = false, search = currentFilter, activeFilter })">
                    <i class="bi bi-pencil-fill me-1"></i> Modify
                </a>
            }
            else
            {
                <a class="btn @(showCreate ? "btn-secondary" : "btn-success") btn-sm me-3"
                   href="@Url.Action("Index", new { showCreate = !showCreate, search = currentFilter, activeFilter })">
                    <i class="bi @(showCreate ? "bi-x-circle" : "bi-plus-lg") me-1"></i>
                    @(showCreate ? "Close" : "Add New")
                </a>
            }

            @using (Html.BeginForm("Index", "Gen_JobOrders", FormMethod.Get, new { @class = "d-flex align-items-center" }))
            {
                <input type="text" name="search" value="@currentFilter"
                       class="form-control form-control-sm me-2"
                       style="width:140px;"
                       placeholder="Search code…" />
                <select name="activeFilter"
                        class="form-select form-select-sm me-2"
                        style="width:100px;">
                    <option value="">All</option>
                    <option value="Yes" @(activeFilter == "Yes" ? "selected" : "")>Active</option>
                    <option value="No" @(activeFilter == "No" ? "selected" : "")>Inactive</option>
                </select>
                <button type="submit" class="btn btn-outline-light btn-sm me-2">
                    <i class="bi bi-search"></i>
                </button>
                <a href="@Url.Action("Index","Gen_JobOrders")"
                   class="btn btn-outline-light btn-sm me-2" title="Reset">
                    <i class="bi bi-x-circle"></i>
                </a>
                <button type="button" onclick="location.reload()"
                        class="btn btn-outline-light btn-sm me-2" title="Refresh">
                    <i class="bi bi-arrow-clockwise"></i>
                </button>
                <button type="button" onclick="window.print()"
                        class="btn btn-outline-light btn-sm" title="Print">
                    <i class="bi bi-printer"></i>
                </button>
                <a href="@Url.Action("ExportMachinesToExcel","Gen_Machines", new { search=currentFilter, activeFilter })"
                   class="btn btn-light btn-sm me-2" title="Excel"><i class="bi bi-file-earmark-spreadsheet text-success"></i></a>
                <a href="@Url.Action("ExportMachinesToPdf","Gen_Machines", new { search=currentFilter, activeFilter })"
                   class="btn btn-light btn-sm" title="PDF"><i class="bi bi-file-earmark-pdf text-danger"></i></a>
            }
        </div>
    </div>

    <!-- INLINE CREATE -->
    @if (showCreate)
    {
        <div class="card mb-4 shadow-sm">
            <div class="card-body d-flex flex-nowrap align-items-end gap-2 overflow-auto">
                @using (Html.BeginForm(
                           "CreateFromIndex",
                           "Gen_JobOrders",
                           FormMethod.Post,
                           new { @class = "d-flex flex-nowrap align-items-end gap-2 w-100" }))
                {
                    @Html.AntiForgeryToken()

                    <div class="d-flex flex-column text-center">
                        @Html.LabelFor(m => m.NewOrder.Code)
                        @Html.TextBoxFor(m => m.NewOrder.Code, new { @class = "form-control form-control-sm text-center", style = "width:80px; font-size:0.85rem; padding:0.25rem 0.5rem;" })
                    </div>

                    <!-- Component -->
                    <div class="d-flex flex-column text-center">
                        @Html.Label("Component")
                        @Html.DropDownListFor(
                            m => m.NewOrder.CompId,
                            Model.ComponentList,
                            "-- select --",
                            new { @class = "form-select form-select-sm" })
                    </div>

                    <!-- ReqRepeats -->
                    <div class="d-flex flex-column text-center">
                        @Html.LabelFor(m => m.NewOrder.ReqRepeats)
                        @Html.TextBoxFor(
                            m => m.NewOrder.ReqRepeats,
                            new { @class = "form-control form-control-sm text-center", type = "number", min = "0", style = "width:120px; font-size:0.85rem; padding:0.25rem 0.5rem;" })
                    </div>

                    <!-- ReqHead -->
                    <div class="d-flex flex-column text-center">
                        @Html.LabelFor(m => m.NewOrder.ReqHead)
                        @Html.TextBoxFor(
                            m => m.NewOrder.ReqHead,
                            new { @class = "form-control form-control-sm text-center", type = "number", min = "0", style = "width:120px; font-size:0.85rem; padding:0.25rem 0.5rem;" })
                    </div>

                    <!-- Panni -->
                    <div class="d-flex flex-column text-center">
                        @Html.LabelFor(m => m.NewOrder.Panni)
                        @Html.TextBoxFor(
                            m => m.NewOrder.Panni,
                            new { @class = "form-control form-control-sm text-center", type = "number", min = "0", style = "width:120px; font-size:0.85rem; padding:0.25rem 0.5rem;" })
                    </div>

                    <!-- Solving -->
                    <div class="d-flex flex-column text-center">
                        @Html.LabelFor(m => m.NewOrder.Solving)
                        @Html.TextBoxFor(
                            m => m.NewOrder.Solving,
                            new { @class = "form-control form-control-sm text-center", type = "number", min = "0", style = "width:120px; font-size:0.85rem; padding:0.25rem 0.5rem;" })
                    </div>

                    <!-- Branch -->
                    <div class="d-flex flex-column text-center">
                        @Html.Label("Branch")
                        @Html.DropDownListFor(
                            m => m.NewOrder.BranchId,
                            Model.BranchList,
                            "-- select branch --",
                            new { @class = "form-select form-select-sm" })
                    </div>

                    <!-- Active switch -->
                    <div class="d-flex flex-column align-items-center">
                        <label class="form-label mb-1">@Html.DisplayNameFor(m => m.NewOrder.Active)</label>
                        <div class="form-check form-switch">
                            @Html.CheckBox(
                                "NewOrder.Active",
                                Model.NewOrder.Active.GetValueOrDefault(false),
                                new { @class = "form-check-input", style = "width:80px;" })
                        </div>
                    </div>

                    <!-- Deleted switch -->
                    <div class="d-flex flex-column align-items-center">
                        <label class="form-label mb-1">@Html.DisplayNameFor(m => m.NewOrder.Deleted)</label>
                        <div class="form-check form-switch">
                            @Html.CheckBox(
                                "NewOrder.Deleted",
                                Model.NewOrder.Deleted.GetValueOrDefault(false),
                                new { @class = "form-check-input", style = "width:80px;" })
                        </div>
                    </div>

                    <!-- Save / Cancel -->
                    <div class="d-flex align-items-center ms-auto" style="gap:8px;">
                        <button type="submit"
                                class="btn btn-success btn-sm"
                                style="font-size:0.90rem; padding:3px 6px;">
                            <i class="bi bi-save me-1"></i>
                            Save
                        </button>
                        <a href="@Url.Action("Index", new { showCreate = false, search = currentFilter, activeFilter })"
                           class="btn btn-outline-secondary btn-sm"
                           style="font-size:0.90rem; padding:3px 6px;">
                            <i class="bi bi-x-circle me-1"></i>
                            Cancel
                        </a>
                    </div>
                }
            </div>
        </div>
    }




    @if (showEdit && editId.HasValue)
    {
        <div class="card mb-4 shadow-sm">
            <div class="card-body d-flex flex-nowrap align-items-end gap-3">
                @using (Html.BeginForm(
                            "EditFromIndex",
                            "Gen_JobOrders",
                            new { id = Model.EditOrder.Id, search = currentFilter, activeFilter },
                            FormMethod.Post,
                            new { @class = "d-flex flex-nowrap align-items-end gap-3 w-100" }))
                {
                    @Html.AntiForgeryToken()
                    @Html.HiddenFor(m => m.EditOrder.Id)

                    <!-- Order Code -->
                    <div class="d-flex flex-column text-center">
                        @Html.LabelFor(m => m.EditOrder.Code)
                        @Html.TextBoxFor(m => m.EditOrder.Code, new { @class = "form-control form-control-sm text-center", style = "width:80px;" })
                    </div>

                    <!-- Component -->
                    <div class="d-flex flex-column text-center">
                        @Html.Label("Component")
                        @Html.DropDownListFor(
                            m => m.EditOrder.CompId,
                            Model.ComponentList,
                            "-- select --",
                            new { @class = "form-select form-select-sm", style = "width:120px;" })
                    </div>

                    <!-- ReqRepeats -->
                    <div class="d-flex flex-column text-center">
                        @Html.LabelFor(m => m.EditOrder.ReqRepeats)
                        @Html.TextBoxFor(
                            m => m.EditOrder.ReqRepeats,
                            new { @class = "form-control form-control-sm text-center", type = "number", min = "0", style = "width:120px;" })
                    </div>

                    <!-- ReqHead -->
                    <div class="d-flex flex-column text-center">
                        @Html.LabelFor(m => m.EditOrder.ReqHead)
                        @Html.TextBoxFor(
                            m => m.EditOrder.ReqHead,
                            new { @class = "form-control form-control-sm text-center", type = "number", min = "0", style = "width:120px;" })
                    </div>

                    <!-- Panni -->
                    <div class="d-flex flex-column text-center">
                        @Html.LabelFor(m => m.EditOrder.Panni)
                        @Html.TextBoxFor(
                            m => m.EditOrder.Panni,
                            new { @class = "form-control form-control-sm text-center", type = "number", min = "0", style = "width:120px;" })
                    </div>

                    <!-- Solving -->
                    <div class="d-flex flex-column text-center">
                        @Html.LabelFor(m => m.EditOrder.Solving)
                        @Html.TextBoxFor(
                            m => m.EditOrder.Solving,
                            new { @class = "form-control form-control-sm text-center", type = "number", min = "0", style = "width:120px;" })
                    </div>

                    <!-- Branch -->
                    <div class="d-flex flex-column text-center">
                        @Html.Label("Branch")
                        @Html.DropDownListFor(
                            m => m.EditOrder.BranchId,
                            Model.BranchList,
                            "-- select branch --",
                            new { @class = "form-select form-select-sm", style = "width:120px;" })
                    </div>

                    <!-- Active switch -->
                    <div class="d-flex flex-column align-items-center">
                        <label class="form-label mb-1">@Html.DisplayNameFor(m => m.EditOrder.Active)</label>
                        <div class="form-check form-switch">
                            @Html.CheckBox(
                                "EditOrder.Active",
                                Model.EditOrder.Active.GetValueOrDefault(false),
                                new { @class = "form-check-input", style = "width:60px;" })
                        </div>
                    </div>

                    <!-- Deleted switch -->
                    <div class="d-flex flex-column align-items-center">
                        <label class="form-label mb-1">@Html.DisplayNameFor(m => m.EditOrder.Deleted)</label>
                        <div class="form-check form-switch">
                            @Html.CheckBox(
                                "EditOrder.Deleted",
                                Model.EditOrder.Deleted.GetValueOrDefault(false),
                                new { @class = "form-check-input", style = "width:60px;" })
                        </div>
                    </div>

                    <!-- Save / Cancel grouped -->
                    <div class="d-flex align-items-center ms-auto" style="gap:4px;">
                        <button type="submit"
                                class="btn btn-success btn-sm"
                                style="font-size:0.90rem; padding:3px 6px;">
                            <i class="bi bi-save me-1"></i>
                            Save
                        </button>
                        <a href="@Url.Action("Index", new { showCreate = false, search = currentFilter, activeFilter })"
                           class="btn btn-outline-secondary btn-sm"
                           style="font-size:0.90rem; padding:3px 6px;">
                            <i class="bi bi-x-circle me-1"></i>
                            Cancel
                        </a>
                    </div>
                }
            </div>
        </div>
    }



    <!-- DATA GRID -->
    <div class="table-responsive shadow-sm rounded">
        <table class="table table-striped table-hover mb-0">
            <thead class="table-dark">
                <tr>
                    <th>Code</th>
                    <th>Component</th>
                    <th class="text-center">Req×</th>
                    <th class="text-center">Req⍺</th>
                    <th class="text-center">Panni</th>
                    <th class="text-center">Solving</th>
                    <th class="text-center">Branch</th>
                    <th class="text-center">Active</th>
                    <th class="text-center">Deleted</th>
                    <th class="text-center">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var o in Model.Orders)
                {
                    <tr>
                        <td>@o.Code</td>
                        <td>@o.ComponentCode</td>
                        <td class="text-center">@o.ReqRepeats</td>
                        <td class="text-center">@o.ReqHead</td>
                        <td class="text-center">@o.Panni</td>
                        <td class="text-center">@o.Solving</td>
                        <td class="text-center">@o.BranchName</td>
                        <td class="text-center">
                            <span class="badge @(o.Active? "bg-success":"bg-secondary")">
                                @(o.Active? "Yes":"No")
                            </span>
                        </td>
                        <td class="text-center">
                            <span class="badge @(o.Deleted? "bg-danger":"bg-secondary")">
                                @(o.Deleted? "Yes":"No")
                            </span>
                        </td>
                        <td class="text-center">
                            <a class="btn btn-sm btn-outline-primary me-1"
                               href="@Url.Action("Index", new { showEdit=true, editId=o.Id, search=currentFilter, activeFilter })"
                               title="Edit">
                                <i class="bi bi-pencil"></i>
                            </a>
                            <a class="btn btn-sm btn-outline-info me-1"
                               href="@Url.Action("Details", new { id=o.Id })"
                               title="Details">
                                <i class="bi bi-info-circle"></i>
                            </a>
                            <a class="btn btn-sm btn-outline-danger"
                               href="@Url.Action("Delete", new { id=o.Id })"
                               title="Delete">
                                <i class="bi bi-trash"></i>
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <!-- PAGINATION -->
    <div class="d-flex justify-content-center mt-3">
        @Html.PagedListPager(Model.Orders, page => Url.Action("Index",
            new { page, search = currentFilter, activeFilter }),
            new PagedListRenderOptions
                 {
                UlElementClasses = new[] { "pagination" },
                LiElementClasses = new[] { "page-item" }
            })
    </div>
</div>

@section Scripts {
    <script>
        $(function () {
            // row highlight
            $('table.table-hover tbody tr').hover(
                function () { $(this).addClass('table-active'); },
                function () { $(this).removeClass('table-active'); }
            );
        });
    </script>
}
