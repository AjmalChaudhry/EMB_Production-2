@model IEnumerable<EMB_Production.ViewModels.CompanyDto>

@{
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Companies List</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <style>
        body {
            font-family: Arial, sans-serif;
            font-size: 12px;
        }

        .table {
            width: 100%;
            border-collapse: collapse;
        }

            .table th,
            .table td {
                border: 1px solid #dee2e6;
                padding: .5rem;
            }

            .table thead th {
                background-color: #f8f9fa;
                font-weight: bold;
            }

        .text-center {
            text-align: center;
        }
    </style>
</head>
<body>
    <h2 class="text-center mb-4">Companies</h2>
    <table class="table">
        <thead>
            <tr>
                <th>Company ID</th>
                <th>Company Name</th>
                <th>Email</th>
                <th>Contact Number</th>
                <th class="text-center">Active</th>
                <th class="text-center">Deleted</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var c in Model)
            {
                <tr>
                    <td>@c.CompanyID</td>
                    <td>@c.CompanyName</td>
                    <td>@c.Email</td>
                    <td>@c.ContactNumber</td>
                    <td class="text-center">@(c.Active ? "Yes" : "No")</td>
                    <td class="text-center">@(c.Deleted ? "Yes" : "No")</td>
                </tr>
            }
        </tbody>
    </table>
</body>
</html>
