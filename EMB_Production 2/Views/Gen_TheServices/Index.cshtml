@model EMB_Production.ViewModels.ServicesPageViewModel
@using PagedList.Mvc
@using PagedList
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    var cf = Model.Search ?? "";
    var af = Model.ActiveFilter ?? "";
    var stf = Model.ServiceTypeFilter?.ToString() ?? "";
    var bf = Model.BranchFilter?.ToString() ?? "";
}

<style>
    .toolbar {
        background: linear-gradient(90deg,#007bff,#0056b3);
        padding: .75rem 1rem;
        border-radius: .5rem;
        box-shadow: 0 2px 6px rgba(0,0,0,.2);
        margin-bottom: 1.5rem;
        color: #fff;
    }

        .toolbar .btn, .toolbar select, .toolbar input {
            font-size: .875rem;
        }

    .inline-form .form-control-sm, .inline-form .form-select-sm, .inline-form .btn-sm {
        font-size: .8rem;
    }

    .table-small th, .table-small td {
        padding: .4rem .6rem;
        font-size: .85rem;
    }
</style>

<div class="toolbar d-flex align-items-center">
    <h5 class="mb-0">Services</h5>
    <div class="ms-3">
        @if (!Model.ShowCreate && !Model.ShowEdit)
        {
            <a class="btn btn-outline-light btn-sm" href="@Url.Action("Index", new { showCreate = true, search = cf, activeFilter = af, serviceTypeFilter = stf, branchFilter = bf })">
                <i class="bi bi-plus-lg me-1"></i> Add
            </a>
        }
        else if (Model.ShowEdit)
        {
            <span class="btn btn-outline-warning btn-sm disabled"><i class="bi bi-pencil-square me-1"></i> Modify</span>
        }
    </div>
    <form method="get" action="@Url.Action("Index")" class="d-flex align-items-center ms-auto gap-2">
        <input name="search" value="@cf" class="form-control form-control-sm" placeholder="Search..." style="width:160px" />
        <select name="activeFilter" class="form-select form-select-sm" style="width:100px">
            <option value="">All</option>
            <option value="Yes" @(af == "Yes" ? "selected" : "")>Active</option>
            <option value="No" @(af == "No" ? "selected" : "")>Inactive</option>
        </select>
        <select name="serviceTypeFilter" class="form-select form-select-sm" style="width:100px">
            <option value="">All Types</option>
            @foreach (SelectListItem lt in Model.ServiceTypeList)
            {
                <option value="@lt.Value" @(lt.Value == stf ? "selected" : "")>@lt.Text</option>
            }
        </select>
        <button type="submit" class="btn btn-light btn-sm"><i class="bi bi-funnel-fill text-primary"></i></button>
        <a class="btn btn-light btn-sm" href="@Url.Action("Index")" title="Clear"><i class="bi bi-x-circle text-bg-success"></i></a>
        <button type="button" onclick="location.reload()" class="btn btn-light btn-sm"><i class="bi bi-arrow-clockwise text-bg-dark"></i></button>
        <button type="button" onclick="window.print()" class="btn btn-light btn-sm"><i class="bi bi-printer text-bg-primary"></i></button>
        <a class="btn btn-light btn-sm" href="@Url.Action("ExportToExcel", "Gen_TheServices", new { search = cf, activeFilter = af, serviceTypeFilter = stf, branchFilter = bf })" title="Excel"><i class="bi bi-file-earmark-spreadsheet text-success"></i></a>
        <a class="btn btn-light btn-sm" href="@Url.Action("ExportToPdf", "Gen_TheServices", new { search = cf, activeFilter = af, serviceTypeFilter = stf, branchFilter = bf })" title="PDF"><i class="bi bi-file-earmark-pdf text-danger"></i></a>
        <div class="mb-3">
            @{
                // look up the display text for the selected service‐type and branch
                var stText = Model.ServiceTypeFilter.HasValue
                    ? Model.ServiceTypeList.FirstOrDefault(x => x.Value == Model.ServiceTypeFilter.Value.ToString())?.Text
                    : null;
                var brText = Model.BranchFilter.HasValue
                    ? Model.BranchList.FirstOrDefault(x => x.Value == Model.BranchFilter.Value.ToString())?.Text
                    : null;
            }
            @* only show badges for filters that are set *@
           @if (!string.IsNullOrWhiteSpace(Model.Search))
            {
                <span class="badge bg-info text-white me-2">Search: @Model.Search</span>
            }
           @if (!string.IsNullOrWhiteSpace(Model.ActiveFilter))
            {
                <span class="badge @(Model.ActiveFilter == "Yes" ? "bg-success" : "bg-secondary") me-2">
                    Active: @Model.ActiveFilter
                </span>
            }
           @if (!string.IsNullOrEmpty(stText))
            {
                <span class="badge bg-primary text-white me-2">Type: @stText</span>
            }
           @if (!string.IsNullOrEmpty(brText))
            {
                <span class="badge bg-primary text-white">Branch: @brText</span>
            }
        </div>
    </form>
</div>

@if (Model.ShowCreate)
{
    <div class="card mb-3 shadow-sm">
        <div class="card-body p-3 bg-light">
            @using (Html.BeginForm("CreateFromIndex", "Gen_TheServices", FormMethod.Post, new { @class = "inline-form row gx-2 gy-1 align-items-end" }))
            {
                @Html.AntiForgeryToken()
                <!-- Type & Name -->
                <div class="col-auto">
                    @Html.DropDownListFor(m => m.NewService.ServiceTypeId, Model.ServiceTypeList, "–Service Type–", new { @class = "form-select form-select-sm" })
                </div>
                <div class="col-auto">
                    @Html.TextBoxFor(m => m.NewService.ServiceName, new { @class = "form-control form-control-sm", placeholder = "Name", style = "width:120px" })
                </div>
                <!-- Rate & Device -->
                <div class="col-auto">
                    @Html.TextBoxFor(m => m.NewService.ServiceRateCharge, new { @class = "form-control form-control-sm", placeholder = "Rate", style = "width:80px" })
                </div>
                <div class="col-auto">
                    @Html.TextBoxFor(m => m.NewService.MachineDevice, new { @class = "form-control form-control-sm", placeholder = "Device", style = "width:80px" })
                </div>
                <!-- Branch & Range -->
                <div class="col-auto">
                    @Html.TextBoxFor(m => m.NewService.MaxRange, new { @class = "form-control form-control-sm", placeholder = "Max Range", style = "width:80px" })
                </div>
                <!-- Charges -->
                <div class="col-auto">
                    @Html.TextBoxFor(m => m.NewService.MaxCharges, "{0:F2}", new { @class = "form-control form-control-sm", placeholder = "Max Chg", style = "width:80px" })
                </div>
                <div class="col-auto">
                    @Html.TextBoxFor(m => m.NewService.MinCharges, "{0:F2}", new { @class = "form-control form-control-sm", placeholder = "Min Chg", style = "width:80px" })
                </div>
                <div class="col-auto">
                    <label class="small mb-1" for="NewService_Field2"></label>
                    @Html.TextBoxFor(m => m.NewService.Field1, new { type = "number", step = "0.01", @class = "form-control form-control-sm text-center", placeholder = "F1", style = "width:80px;", id = "NewService_Field1" })
                </div>
                <div class="col-auto d-flex flex-column align-items-center">
                    <label class="small mb-1" for="NewService_Field2"></label>
                    @Html.TextBoxFor(m => m.NewService.Field2, new { type = "number", step = "0.01", @class = "form-control form-control-sm text-center", placeholder = "F2", style = "width:80px;", id = "NewService_Field2" })
                </div>
                <div class="col-auto">
                    @Html.DropDownListFor(m => m.NewService.BranchId, Model.BranchList, "–Branch–", new { @class = "form-select form-select-sm" })
                </div>               
                <!-- Flags -->
                <div class="col-auto d-flex flex-column align-items-center">
                    <label class="form-check-label small mb-1">Active</label>
                    @Html.CheckBoxFor(m => m.NewService.Active, new { @class = "form-check-input" })
                </div>
                <div class="col-auto d-flex flex-column align-items-center">
                    <label class="form-check-label small mb-1">Deleted</label>
                    @Html.CheckBoxFor(m => m.NewService.Deleted, new { @class = "form-check-input" })
                </div>
                <!-- Actions -->
                <div class="col-auto ms-auto d-flex gap-1">
                    <button type="submit" class="btn btn-sm btn-success"><i class="bi bi-save me-1"></i>Save</button>
                    <a class="btn btn-sm btn-outline-secondary" href="@Url.Action("Index", new { showCreate = false, search = cf, activeFilter = af, serviceTypeFilter = stf, branchFilter = bf })"><i class="bi bi-x-circle me-1"></i>Cancel</a>
                </div>
            }
        </div>
    </div>
}

@if (Model.ShowEdit)
{
    <div class="card mb-3 shadow-sm">
        <div class="card-body p-3 bg-light">
            @using (Html.BeginForm("EditFromIndex", "Gen_TheServices", FormMethod.Post, new { @class = "inline-form row gx-2 gy-1 align-items-end" }))
            {
                @Html.AntiForgeryToken()
                @Html.HiddenFor(m => m.EditService.Id)
                <!-- replicate create inputs binding EditService instead of NewService -->
                <div class="col-auto">
                    @Html.DropDownListFor(m => m.EditService.ServiceTypeId, Model.ServiceTypeList, "–Service Type–", new { @class = "form-select form-select-sm" })
                </div>
                <div class="col-auto">
                    @Html.TextBoxFor(m => m.EditService.ServiceName, new { @class = "form-control form-control-sm", style = "width:130px" })
                </div>
                <div class="col-auto">
                    @Html.TextBoxFor(m => m.EditService.ServiceRateCharge, new { @class = "form-control form-control-sm", style = "width:70px" })
                </div>
                <div class="col-auto">
                    @Html.TextBoxFor(m => m.EditService.MachineDevice, new { @class = "form-control form-control-sm", style = "width:70px" })
                </div>
                <div class="col-auto">
                    @Html.TextBoxFor(m => m.EditService.MaxRange, new { @class = "form-control form-control-sm", style = "width:70px" })
                </div>
                <div class="col-auto">
                    @Html.TextBoxFor(m => m.EditService.MaxCharges, "{0:F2}", new { @class = "form-control form-control-sm", style = "width:70px" })
                </div>
                <div class="col-auto">
                    @Html.TextBoxFor(m => m.EditService.MinCharges, "{0:F2}", new { @class = "form-control form-control-sm", style = "width:70px" })
                </div>
                <div class="col-auto">
                    @Html.TextBoxFor(m => m.EditService.Field1, "{0:F2}", new { @class = "form-control form-control-sm", style = "width:70px" })
                </div>
                <div class="col-auto">
                    @Html.TextBoxFor(m => m.EditService.Field2, "{0:F2}", new { @class = "form-control form-control-sm", style = "width:70px" })
                </div>
                <div class="col-auto">
                    @Html.DropDownListFor(m => m.EditService.BranchId, Model.BranchList, "–Branch–", new { @class = "form-select form-select-sm" })
                </div>
                <div class="col-auto d-flex flex-column align-items-center">
                    <label class="form-check-label small mb-1">Active</label>
                    @Html.CheckBoxFor(m => m.EditService.Active, new { @class = "form-check-input" })
                </div>
                <div class="col-auto d-flex flex-column align-items-center">
                    <label class="form-check-label small mb-1">Deleted</label>
                    @Html.CheckBoxFor(m => m.EditService.Deleted, new { @class = "form-check-input" })
                </div>
                <div class="col-auto ms-auto d-flex gap-1">
                    <button type="submit" class="btn btn-sm btn-success"><i class="bi bi-save me-1"></i>Update</button>
                    <a class="btn btn-sm btn-outline-secondary" href="@Url.Action("Index", new { showEdit = false, search = cf, activeFilter = af, serviceTypeFilter = stf, branchFilter = bf })"><i class="bi bi-x-circle me-1"></i>Cancel</a>
                </div>
            }
        </div>
    </div>
}

<div class="table-responsive shadow-sm rounded">
    <table class="table table-striped table-hover table-small mb-0">
        <thead class="table-secondary">
            <tr>
                <th>Type</th>
                <th>Name</th>
                <th>Rate</th>
                <th>Device</th>
                <th>Range</th>
                <th>Max Chg</th>
                <th>Min Chg</th>
                <th>Field1</th>
                <th>Field2</th>
                <th>Branch</th>
                <th class="text-center">Updated</th>
                <th class="text-center">Act</th>
                <th class="text-center">Del</th>
                <th class="text-center">Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var r in Model.Rows)
            {
            <tr>
                <td>@r.ServiceTypeName</td>
                <td>@r.ServiceName</td>
                <td>@r.ServiceRateCharge</td>
                <td>@r.MachineDevice</td>
                <td>@r.MaxRange</td>
                <td>@r.MaxCharges</td>
                <td>@r.MinCharges</td>
                <td>@r.Field1</td>
                <td>@r.Field2</td>
                <td>@r.BranchName</td>
                <td class="text-center">@(r.UpdatedDate?.ToString("yyyy-MM-dd") ?? "")</td>
                <td class="text-center"><span class="badge @(r.Active ? "bg-success" : "bg-secondary")">@(r.Active ? "Yes" : "No")</span></td>
                <td class="text-center"><span class="badge @(r.Deleted ? "bg-danger" : "bg-secondary")">@(r.Deleted ? "Yes" : "No")</span></td>
                <td class="text-center">
                    <a class="btn btn-outline-primary btn-sm me-1" href="@Url.Action("Index", "Gen_TheServices", new { showEdit = true, editId = r.Id, search = cf, activeFilter = af, serviceTypeFilter = stf, branchFilter = bf })"><i class="bi bi-pencil"></i></a>
                    <a class="btn btn-outline-info btn-sm me-1" href="@Url.Action("Details", "Gen_TheServices", new { id = r.Id })"><i class="bi bi-info-circle"></i></a>
                    <a class="btn btn-outline-danger btn-sm" href="@Url.Action("Delete", "Gen_TheServices", new { id = r.Id })"><i class="bi bi-trash"></i></a>
                </td>
            </tr>
            }
        </tbody>
    </table>
</div>

<div class="d-flex justify-content-center mt-3">
    @Html.PagedListPager(Model.Rows, page => Url.Action("Index", new { page, search = cf, activeFilter = af, serviceTypeFilter = stf, branchFilter = bf }), new PagedListRenderOptions { UlElementClasses = new[] { "pagination" }, LiElementClasses = new[] { "page-item" }})

</div>
