@model EMB_Production.Models.Gen_TheServices

@{
    ViewBag.Title = "Delete Service";
}
<style>
    .detail-card {
        background: #fff;
        border-left: 5px solid #dc3545;
        border-radius: 8px;
        padding: 1.5rem;
        box-shadow: 0 2px 12px rgba(0,0,0,0.1);
        margin-top: 1rem;
    }

    .details-header {
        font-size: 1.25rem;
        font-weight: 600;
        background: #dc3545;
        color: #fff;
        padding: .75rem 1rem;
        border-radius: 6px 6px 0 0;
        margin: -1.5rem -1.5rem 1rem;
    }

    .detail-label {
        font-weight: 600;
        font-size: .9rem;
        color: #2c3e50;
    }

    .detail-value {
        font-size: 1rem;
        color: #34495e;
        word-wrap: break-word;
    }
</style>
<div class="detail-card">
    <div class="details-header">Delete Service</div>

    <div class="alert alert-warning shadow-sm rounded mb-4">
        <strong>Are you sure you want to delete this service record?</strong>
        <p>This action cannot be undone.</p>
    </div>

    <div class="bg-white p-4 rounded shadow-sm">
        <div class="row">
            <!-- Gen_ServiceType lookup -->
            <div class="col-md-4 mb-3">
                <div class="detail-label">Gen_ServiceType</div>
                <div class="detail-value">
                    @(Model.Gen_ServiceType != null
                    ? Model.Gen_ServiceType.Service_Type
                    : $"(ID: {Model.Service_Type})")
                </div>
            </div>

            <!-- Branch lookup -->
            <div class="col-md-4 mb-3">
                <div class="detail-label">Branch</div>
                <div class="detail-value">
                    @(Model.Branches != null
                    ? Model.Branches.Name
                    : $"(ID: {Model.BranchId})")
                </div>
            </div>

            <!-- Gen_Machines count -->
            <div class="col-md-4 mb-3">
                <div class="detail-label">Gen_Machines</div>
                <div class="detail-value">
                    @(Model.Gen_Machines != null ? Model.Gen_Machines.Count : 0)
                </div>
            </div>

            <!-- Gen_ServiceRates count -->
            <div class="col-md-4 mb-3">
                <div class="detail-label">Gen_ServiceRates</div>
                <div class="detail-value">
                    @(Model.Gen_ServiceRates != null ? Model.Gen_ServiceRates.Count : 0)
                </div>
            </div>

            @* Now render all other scalar props *@
            @foreach (var prop in ViewData.ModelMetadata.Properties
                 .Where(p => p.ShowForDisplay
                             && p.PropertyName != nameof(Model.Service_Type)
                             && p.PropertyName != nameof(Model.Gen_ServiceType)
                             && p.PropertyName != nameof(Model.BranchId)
                             && p.PropertyName != nameof(Model.Branches)
                             && p.PropertyName != nameof(Model.Gen_Machines)
                             && p.PropertyName != nameof(Model.Gen_ServiceRates)))
            {
                <div class="col-md-4 mb-3">
                    <div class="detail-label">@prop.GetDisplayName()</div>
                    <div class="detail-value">
                        @if (prop.Model is DateTime dt)
                        {
                            @dt.ToString("yyyy-MM-dd HH:mm:ss") }
                        else
                        {
                            @prop.Model}
                    </div>
                </div>
            }
        </div>

        @using (Html.BeginForm("Delete", "Gen_TheServices", FormMethod.Post))
        {
            @Html.AntiForgeryToken()
            @Html.HiddenFor(m => m.Id)
            <div class="d-flex justify-content-end mt-4">
                <input type="submit" value="Confirm Delete" class="btn btn-danger me-2" />
                @Html.ActionLink("Cancel", "Index", null, new { @class = "btn btn-outline-secondary" })
            </div>
        }
    </div>
</div>