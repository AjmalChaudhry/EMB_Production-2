@model EMB_Production.Models.Hr_Customers

@{
    ViewBag.Title = "Delete";
}
<style>
    .detail-card {
        background: #fff;
        border-left: 5px solid #dc3545;
        border-radius: 8px;
        padding: 1.5rem;
        box-shadow: 0 2px 12px rgba(0,0,0,0.1);
        margin-top: 1rem;
    }

    .details-header {
        font-size: 1.25rem;
        font-weight: 600;
        background: #dc3545;
        color: #fff;
        padding: .75rem 1rem;
        border-radius: 6px 6px 0 0;
        margin: -1.5rem -1.5rem 1rem;
    }

    .detail-label {
        font-weight: 600;
        font-size: .9rem;
        color: #2c3e50;
    }

    .detail-value {
        font-size: 1rem;
        color: #34495e;
        word-wrap: break-word;
    }
</style>
<div class="detail-card">
    <div class="details-header">Delete Service</div>

    <div class="alert alert-warning shadow-sm rounded mb-4">
        <strong>Are you sure you want to delete this company?</strong>
        <p>This action cannot be undone.</p>
    </div>

    <div class="bg-white p-4 rounded shadow-sm">
        <div class="row">
            @foreach (var prop in ViewData.ModelMetadata.Properties.Where(p => p.ShowForDisplay && p.PropertyName != "Id" && p.PropertyName != "Gen_ServiceRates" && p.PropertyName != "Branches"))
            {
                <div class="col-md-4 mb-3">
                    <div class="detail-label">@prop.GetDisplayName()</div>
                    <div class="detail-label">@prop.Model</div>
                </div>
            }
        </div>

        @using (Html.BeginForm())
        {
            @Html.AntiForgeryToken()

            <div class="d-flex justify-content-end mt-4">
                <input type="submit" value="Confirm Delete" class="btn btn-danger me-2" />
                @Html.ActionLink("Cancel", "Index", null, new { @class = "btn btn-outline-secondary" })
            </div>
        }
    </div>
</div>