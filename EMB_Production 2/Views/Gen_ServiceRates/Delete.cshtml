@model EMB_Production.Models.Gen_ServiceRates

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Delete Service Rate";
}

<style>
    .detail-card {
        background: #fff;
        border-left: 5px solid #dc3545; /* danger accent */
        border-radius: 8px;
        padding: 1.5rem;
        box-shadow: 0 2px 12px rgba(0,0,0,0.1);
        margin-top: 1rem;
    }

    .details-header {
        font-size: 1.25rem;
        font-weight: 600;
        background: #dc3545;
        color: #fff;
        padding: .75rem 1rem;
        border-radius: 6px 6px 0 0;
        margin: -1.5rem -1.5rem 1rem;
    }

    .detail-label {
        font-weight: 600;
        font-size: .9rem;
        color: #2c3e50;
    }

    .detail-value {
        font-size: 1rem;
        color: #34495e;
        word-wrap: break-word;
    }
</style>

<div class="detail-card">
    <div class="details-header">Delete Service Rate</div>

    <div class="alert alert-warning shadow-sm rounded mb-4">
        <strong>Are you sure you want to delete this service rate?</strong>
        <p>This action cannot be undone.</p>
    </div>

    <div class="bg-white p-4 rounded shadow-sm mb-4">
        <div class="row gy-3">
            <div class="col-md-3">
                <div class="detail-label">ID</div>
                <div class="detail-value">@Model.Id</div>
            </div>
            <div class="col-md-3">
                <div class="detail-label">Customer</div>
                <div class="detail-value">
                    @(Model.Hr_Customers?.Customer_Id ?? "(none)")
                </div>
            </div>
            <div class="col-md-3">
                <div class="detail-label">Service</div>
                <div class="detail-value">
                    @(Model.Gen_TheServices?.Service_Name ?? "(none)")
                </div>
            </div>
            <div class="col-md-3">
                <div class="detail-label">Charge Factor</div>
                <div class="detail-value">@Model.Charge_Fector</div>
            </div>
            <div class="col-md-3">
                <div class="detail-label">Remarks</div>
                <div class="detail-value">@Model.Remarks</div>
            </div>
            <div class="col-md-3">
                <div class="detail-label">Branch</div>
                <div class="detail-value">
                    @(Model.Branches?.Name ?? "(none)")
                </div>
            </div>
            <div class="col-md-3">
                <div class="detail-label">Active</div>
                <div class="detail-value">
                    <span class="badge @(Model.Active == true ? "bg-success" : "bg-secondary")">
                        @(Model.Active == true ? "Yes" : "No")
                    </span>
                </div>
            </div>
            <div class="col-md-3">
                <div class="detail-label">Deleted</div>
                <div class="detail-value">
                    <span class="badge @(Model.Deleted == true ? "bg-danger" : "bg-secondary")">
                        @(Model.Deleted == true ? "Yes" : "No")
                    </span>
                </div>
            </div>
            <div class="col-md-3">
                <div class="detail-label">Record Timestamp</div>
                <div class="detail-value">
                    @(Model.RecordTimeStamp.HasValue
                        ? Model.RecordTimeStamp.Value.ToString("yyyy-MM-dd HH:mm:ss")
                        : "(none)")
                </div>
            </div>
            <div class="col-md-3">
                <div class="detail-label">Created By</div>
                <div class="detail-value">
                    @(Model.CreatedBy?.ToString() ?? "(none)")
                </div>
            </div>
            <div class="col-md-3">
                <div class="detail-label">Created Date</div>
                <div class="detail-value">
                    @(Model.CreatedDate.HasValue
                        ? Model.CreatedDate.Value.ToString("yyyy-MM-dd HH:mm:ss")
                        : "(none)")
                </div>
            </div>
            <div class="col-md-3">
                <div class="detail-label">Updated By</div>
                <div class="detail-value">
                    @(Model.UpdatedBy?.ToString() ?? "(none)")
                </div>
            </div>
            <div class="col-md-3">
                <div class="detail-label">Updated Date</div>
                <div class="detail-value">
                    @(Model.UpdatedDate.HasValue
                        ? Model.UpdatedDate.Value.ToString("yyyy-MM-dd HH:mm:ss")
                        : "(none)")
                </div>
            </div>
        </div>
    </div>

    @using (Html.BeginForm("Delete", "Gen_ServiceRates", FormMethod.Post))
    {
        @Html.AntiForgeryToken()
        @Html.HiddenFor(m => m.Id)

        <div class="d-flex justify-content-end">
            <button type="submit" class="btn btn-danger me-2">
                <i class="bi bi-trash"></i> Confirm Delete
            </button>
            @Html.ActionLink(
                "Cancel",
                "Index",
                null,
                new { @class = "btn btn-outline-secondary" })
        </div>
    }
</div>
