@{
    Layout = null;
    ViewBag.Title = "Login";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>@ViewBag.Title</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css"
          rel="stylesheet"
          integrity="sha384-…" crossorigin="anonymous" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css"
          rel="stylesheet" />

    <style>
        html, body {
            height: 100%;
            margin: 0;
        }

        .login-card {
            width: 100%;
            max-width: 800px;
            margin: 0 1rem;
            border-radius: 1rem;
            overflow: hidden;
            box-shadow: 0 4px 20px rgba(0,0,0,0.15);
            background: #fff;
        }

        .login-left {
            background-image: url('/Content/images.jpg');
            background-position: center;
            background-size: cover;
            background-repeat: no-repeat;
            min-height: 100%;
        }

        .login-body {
            padding: 2rem;
            display: flex;
            flex-direction: column;
            align-items: center;
            text-align: center;
            justify-content: center;
        }

        .login-form {
            width: 100%;
            max-width: 360px;
        }

        .input-icon {
            position: absolute;
            top: 50%;
            left: 1rem;
            transform: translateY(-50%);
            color: #6c757d;
            pointer-events: none;
        }

        .login-input {
            width: 100%;
            padding-left: 3rem;
            height: 45px;
            border-radius: 50px;
            text-align: center;
        }

            .login-input::placeholder {
                text-align: center;
            }

        .login-btn {
            width: 100%;
            height: 45px;
            border-radius: 50px;
        }
    </style>

</head>
<body class="bg-light d-flex justify-content-center align-items-center vh-100">

    <div class="login-card">
        <div class="row g-0">
            <div class="col-md-2 d-none d-md-block login-left"></div>
            <div class="col-12 col-md-8 d-flex justify-content-center align-items-center">
                <div class="login-body">

                    <h1 class="login-logo mb-3">EMB Production</h1>
                    <h2 class="text-success mb-4">Login</h2>

                    @using (Html.BeginForm("Login", "Home", FormMethod.Post, new { id = "loginForm", autocomplete = "off", @class = "login-form" }))
                    {
                        @Html.AntiForgeryToken()
                        @Html.ValidationSummary(true, "", new { @class = "text-danger mb-3" })

                        <!-- Email Field -->
                        <div class="position-relative mb-3">
                            <i class="bi bi-envelope input-icon"></i>
                            <input type="email"
                                   name="email"
                                   class="form-control login-input"
                                   placeholder="Email"
                                   value="@(Request.Form["email"] ?? "")"
                                   required />
                            <div id="emailError" class="text-danger small mt-1"></div>
                        </div>

                        <!-- Password Field -->
                        <div class="position-relative mb-4">
                            <i class="bi bi-lock input-icon"></i>
                            <input type="password"
                                   name="password"
                                   class="form-control login-input"
                                   placeholder="Password"
                                   required />
                            <div id="passwordError" class="text-danger small mt-1"></div>
                        </div>

                        <!-- Submit -->
                        <button type="submit" class="btn btn-success login-btn mb-3">
                            Login
                        </button>
                    }

                    <p class="small mb-0">
                        <a href="@Url.Action("Recover","Home")" class="text-success">
                            Forgot Email or Password?
                        </a>
                    </p>
                    <p class="small mb-0">
                        <a href="@Url.Action("Create","Adm_Users")" class="text-success">
                            Create New User
                        </a>
                    </p>

                </div>
            </div>
        </div>
    </div>

    <!-- Bootstrap JS bundle -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"
            integrity="sha384-…" crossorigin="anonymous">
    </script>
    <script>
        (function () {
            const form = document.getElementById("loginForm");
            form.addEventListener("submit", function (e) {
                let ok = true;
                if (!form.email.value.trim()) {
                    document.getElementById("emailError").innerText = "Email is required";
                    ok = false;
                }
                if (!form.password.value.trim()) {
                    document.getElementById("passwordError").innerText = "Password is required";
                    ok = false;
                }
                if (!ok) e.preventDefault();
            });
        })();
    </script>
</body>
</html>
