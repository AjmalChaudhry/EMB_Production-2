@model EMB_Production.ViewModels.MachineParametersPageViewModel

@{
    Layout = null;
}

<div class="table-responsive shadow-sm rounded">
    <table class="table table-striped table-hover align-middle small mb-0">
        <thead class="table-secondary">
            <tr>
                <th>Machine</th>
                <th>Head-to-Head</th>
                <th>Frame Height</th>
                <th class="text-center">Active</th>
                <th class="text-center">Deleted</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var r in Model.Rows)
            {
                <tr>
                    <td class="text-wrap">@r.MachineCode</td>
                    <td class="text-wrap">@r.HeadToHead</td>
                    <td class="text-wrap">@r.FrameHeight</td>
                    <td class="text-center">
                        <span class="badge @(r.Active ? "bg-success" : "bg-secondary")">
                            @(r.Active ? "Yes" : "No")
                        </span>
                    </td>
                    <td class="text-center">
                        <span class="badge @(r.Deleted ? "bg-danger" : "bg-secondary")">
                            @(r.Deleted ? "Yes" : "No")
                        </span>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
