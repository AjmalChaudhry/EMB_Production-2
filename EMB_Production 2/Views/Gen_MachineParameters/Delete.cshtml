@model EMB_Production.Models.Gen_MachineParameters

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Delete Parameter";
    var currentFilter = Request.QueryString["search"] ?? "";
    var activeFilter = Request.QueryString["activeFilter"] ?? "";
}

<style>
    .detail-card {
        background: #fff;
        border-left: 5px solid #dc3545;
        border-radius: 8px;
        padding: 1.5rem;
        box-shadow: 0 2px 12px rgba(0,0,0,0.1);
        margin-top: 1rem;
    }

    .details-header {
        font-size: 1.25rem;
        font-weight: 600;
        background: #dc3545;
        color: #fff;
        padding: .75rem 1rem;
        border-radius: 6px 6px 0 0;
        margin: -1.5rem -1.5rem 1rem;
    }

    .detail-label {
        font-weight: 600;
        font-size: .9rem;
        color: #2c3e50;
    }

    .detail-value {
        font-size: 1rem;
        color: #34495e;
        word-wrap: break-word;
    }

    .toolbar-container .btn {
        margin-left: .5rem;
    }
</style>

<div class="detail-card">
    <div class="details-header">Delete Machine Parameter</div>

  

    <div class="bg-white p-4 rounded shadow-sm mb-4">
        <div class="row gy-4">
            <!-- Related Machine -->
            <div class="col-md-4">
                <div class="detail-label">Machine</div>
                <div class="detail-value">
                    @(Model.Gen_Machines != null
                        ? Model.Gen_Machines.Code
                        : $"(ID: {Model.MachineId})")
                </div>
            </div>

            @* Loop through all other scalar properties *@
            @foreach (var prop in ViewData.ModelMetadata.Properties
                .Where(p =>
                    p.ShowForDisplay &&
                    p.PropertyName != nameof(Model.Id) &&
                    p.PropertyName != nameof(Model.MachineId) &&
                    p.PropertyName != nameof(Model.Gen_Machines)))
            {
                <div class="col-md-4">
                    <div class="detail-label">@prop.GetDisplayName()</div>
                    <div class="detail-value">
                        @if (prop.Model is DateTime dt)
                        {
                            @dt.ToString("yyyy-MM-dd HH:mm:ss")
                        }
                        else
                        {
                            @prop.Model
                        }
                    </div>
                </div>
            }
        </div>
    </div>

    @using (Html.BeginForm("Delete", "Gen_MachineParameters", FormMethod.Post))
    {
        @Html.AntiForgeryToken()
        @Html.HiddenFor(m => m.Id)

        <div class="d-flex justify-content-end">
            <button type="submit" class="btn btn-danger me-2">
                Confirm Delete
            </button>
            @Html.ActionLink("Cancel", "Index", new { search = currentFilter, activeFilter = activeFilter },
                new { @class = "btn btn-outline-secondary" })
        </div>
    }
</div>
