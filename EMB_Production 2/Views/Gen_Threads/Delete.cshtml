@model EMB_Production.Models.Gen_Threads

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Delete Thread";
}

<style>
    .detail-card {
        background: #fff;
        border-left: 5px solid #dc3545;
        border-radius: 8px;
        padding: 1.5rem;
        box-shadow: 0 2px 12px rgba(0,0,0,0.1);
        margin-top: 1rem;
    }

    .details-header {
        font-size: 1.25rem;
        font-weight: 600;
        background: #dc3545;
        color: #fff;
        padding: .75rem 1rem;
        border-radius: 6px 6px 0 0;
        margin: -1.5rem -1.5rem 1rem;
    }

    .detail-label {
        font-weight: 600;
        font-size: .9rem;
        color: #2c3e50;
    }

    .detail-value {
        font-size: 1rem;
        color: #34495e;
        word-wrap: break-word;
        padding: .25rem .5rem;
        transition: background .2s;
    }

        .detail-value:hover {
            background: #f8f9fa;
            border-radius: 4px;
        }
</style>

<div class="detail-card">
    <div class="details-header">Delete Thread</div>

    <div class="alert alert-warning rounded mb-4">
        <strong>Are you sure you want to delete this thread?</strong>
        <p>This action cannot be undone.</p>
    </div>

    <div class="bg-white p-4 rounded shadow-sm mb-4">
        <div class="row gy-4">
            @* loop through all scalar properties except the PK and nav props *@
            @foreach (var prop in ViewData.ModelMetadata.Properties
                         .Where(p =>
                             p.ShowForDisplay
                             && p.PropertyName != nameof(Model.Id)
                             && p.PropertyName != nameof(Model.Branches)))
            {
                <div class="col-md-4">
                    <div class="detail-label">@prop.GetDisplayName()</div>
                    <div class="detail-value">
                        @if (prop.Model is bool b)
                        {
                            @(b ? "Yes" : "No")
                        }
                        else if (prop.Model is DateTime dt)
                        {
                            @dt.ToString("yyyy-MM-dd HH:mm:ss")
                        }
                        else
                        {
                            @prop.Model
                        }
                    </div>
                </div>
            }

            @* Branch lookup *@
            <div class="col-md-4">
                <div class="detail-label">Branch</div>
                <div class="detail-value">
                    @(Model.Branches != null
                        ? Model.Branches.Name
                        : "(none)")
                </div>
            </div>
        </div>
    </div>

    @using (Html.BeginForm("Delete", "Gen_Threads", FormMethod.Post))
    {
        @Html.AntiForgeryToken()
        @Html.HiddenFor(m => m.Id)
        <div class="d-flex justify-content-end">
            <button type="submit" class="btn btn-danger me-2">
                <i class="bi bi-trash-fill"></i> Confirm Delete
            </button>
            @Html.ActionLink("Cancel", "Index", null, new { @class = "btn btn-outline-secondary" })
        </div>
    }
</div>
