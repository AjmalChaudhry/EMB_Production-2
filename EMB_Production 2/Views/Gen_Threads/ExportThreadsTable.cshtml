@model EMB_Production.ViewModels.ThreadsPageViewModel

@{
    Layout = null;
}

<table class="table table-striped table-hover">
    <thead class="table-info">
        <tr>
            <th>Code</th>
            <th>Name</th>
            <th>Type</th>
            <th>Material</th>
            <th>Yarn Count</th>
            <th>Color</th>
            <th>Unit Length</th>
            <th>UOM</th>
            <th>Unit Cost</th>
            <th>Supplier</th>
            <th>Branch</th>
            <th class="text-center">Active</th>
            <th class="text-center">Deleted</th>
            <th class="text-center">Actions</th>
        </tr>
    </thead>
    <tbody>
       @foreach (var t in Model.Threads)
        {
            <tr>
                <td>@t.Code</td>
                <td>@t.Name</td>
                <td>@t.Type</td>
                <td>@t.Material</td>
                <td>@t.YarnCount</td>
                <td>@t.Color</td>
                <td>@t.UnitLength</td>
                <td>@t.UnitOfMeasure</td>
                <td>@t.UnitCost?.ToString("F2")</td>
                <td>@t.SupplierId</td>
                <td>@t.BranchName</td>
                <td class="text-center">
                    <span class="badge @(t.Active ? "bg-success":"bg-secondary")">
                        @(t.Active?"Yes":"No")
                    </span>
                </td>
                <td class="text-center">
                    <span class="badge @(t.Deleted ? "bg-danger":"bg-secondary")">
                        @(t.Deleted?"Yes":"No")
                    </span>
                </td>
                <td class="text-center">
                    @* your Edit/Create buttons here *@
                </td>
            </tr>
        }
    </tbody>
</table>

