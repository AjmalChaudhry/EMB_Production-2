@using EMB_Production.ViewModels
@using PagedList.Mvc
@model ComponentsPageViewModel

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    string currentFilter = Model.Search ?? "";
    string activeFilter = Model.ActiveFilter ?? "";
    bool showCreate = Model.ShowCreate;
    bool showEdit = Model.ShowEdit;
    int? editId = Model.EditId;
}

<style>
    /* Toolbar styling */
    .toolbar-container {
        background: #eef4fc;
        border-radius: 8px;
        padding: 12px 20px;
        box-shadow: 0 2px 6px rgba(0,0,0,0.1);
        margin-bottom: 20px;
    }

        .toolbar-container .btn {
            border-radius: 4px;
            margin-left: 6px;
        }
    /* Form card styling */
    .inline-card {
        background: #ffffff;
        border-left: 5px solid #007bff;
        border-radius: 8px;
        padding: 16px;
        box-shadow: 0 2px 8px rgba(0,0,0,0.1);
        margin-bottom: 20px;
    }
    /* Data table styling */
    .data-card {
        background: #ffffff;
        border-radius: 8px;
        box-shadow: 0 2px 8px rgba(0,0,0,0.1);
        overflow: hidden;
    }

        .data-card thead {
            background: #003865;
            color: #ffffff;
        }

            .data-card thead th {
                border-bottom: 2px solid #002a50;
                text-transform: uppercase;
                font-weight: 600;
                padding: 12px 15px;
            }

        .data-card tbody tr:hover {
            background: #f1f9ff;
        }

    .badge-active {
        background-color: #28a745;
    }

    .badge-inactive {
        background-color: #6c757d;
    }

    .form-switch-label {
        display: block;
        text-align: center;
        margin-bottom: 4px;
        font-weight: 500;
    }
</style>

<div class="container-fluid py-4">
    <!-- TOP BAR -->
    <div class="toolbar-container d-flex align-items-center justify-content-between">
        <h2 class="mb-0 text-primary">Components</h2>
        <div class="d-flex align-items-center">
            @if (showEdit)
            {
                <a class="btn btn-warning btn-sm"
                   href="@Url.Action("Index","Gen_Components", new { showEdit = false, search = currentFilter })">
                    <i class="bi bi-pencil-fill me-1"></i> Modify
                </a>
            }
            else
            {
                <a class="btn @(showCreate ? "btn-secondary" : "btn-success") btn-sm"
                   href="@Url.Action("Index","Gen_Components", new { showCreate = !showCreate, search = currentFilter })">
                    <i class="bi @(showCreate ? "bi-x-lg" : "bi-plus-lg") me-1"></i>
                    @(showCreate ? "Close" : "Add New")
                </a>
            }
            @using (Html.BeginForm("Index", "Gen_Components", FormMethod.Get, new { @class = "d-flex align-items-center ms-3" }))
            {
                <input type="text" name="search" value="@currentFilter"
                       class="form-control form-control-sm me-2" style="width:160px;"
                       placeholder="Search…" />
                <button type="submit" class="btn btn-primary btn-sm me-2">
                    <i class="bi bi-search"></i>
                </button>
                <a href="@Url.Action("Index","Gen_Components")"
                   class="btn btn-outline-secondary btn-sm me-2">
                    <i class="bi bi-x-circle"></i>
                </a>
                <button type="button" onclick="location.reload()"
                        class="btn btn-outline-secondary btn-sm me-2">
                    <i class="bi bi-arrow-clockwise"></i>
                </button>
                <button type="button" onclick="window.print()"
                        class="btn btn-outline-secondary btn-sm me-2">
                    <i class="bi bi-printer"></i>
                </button>
                <a href="@Url.Action("ExportComponentsToExcel","Gen_Components", new { search = currentFilter, activeFilter = activeFilter })"
                   class="btn btn-success btn-sm me-2">
                    <i class="bi bi-file-earmark-spreadsheet"></i>
                </a>
                <a href="@Url.Action("ExportComponentsToPdf","Gen_Components", new { search = currentFilter, activeFilter = activeFilter })"
                   class="btn btn-danger btn-sm">
                    <i class="bi bi-file-earmark-pdf"></i>
                </a>
            }
        </div>
    </div>

    <!-- INLINE CREATE -->
    @if (showCreate)
    {
        <div class="inline-card">
            <div class="row g-2 align-items-end">
                @using (Html.BeginForm("CreateFromIndex", "Gen_Components", FormMethod.Post))
                {
                    @Html.AntiForgeryToken()
                    <div class="row g-2">
                        <div class="col-md-1">
                            @Html.LabelFor(m => m.NewComponent.Code)
                            @Html.TextBoxFor(m => m.NewComponent.Code, new { @class = "form-control form-control-sm" })
                        </div>
                        <div class="col-md-1">
                            @Html.LabelFor(m => m.NewComponent.D_Code, "Design")
                            @Html.DropDownListFor(m => m.SelectedDesignId, (SelectList)ViewBag.DesignList, "-- select design --",
                            new { @class = "form-select form-select-sm" })
                        </div>
                        <div class="col-md-1">@Html.LabelFor(m => m.NewComponent.Name)@Html.TextBoxFor(m => m.NewComponent.Name, new { @class = "form-control form-control-sm" })</div>
                        <div class="col-md-1">@Html.LabelFor(m => m.NewComponent.HeadToHead)@Html.TextBoxFor(m => m.NewComponent.HeadToHead, new { @class = "form-control form-control-sm" })</div>
                        <div class="col-md-1">@Html.LabelFor(m => m.NewComponent.Stitch)@Html.TextBoxFor(m => m.NewComponent.Stitch, new { @class = "form-control form-control-sm" })</div>
                        <div class="col-md-1">@Html.LabelFor(m => m.NewComponent.Tilla)@Html.TextBoxFor(m => m.NewComponent.Tilla, new { @class = "form-control form-control-sm" })</div>
                        <div class="col-md-1">@Html.LabelFor(m => m.NewComponent.Seq_A)@Html.TextBoxFor(m => m.NewComponent.Seq_A, new { @class = "form-control form-control-sm" })</div>
                        <div class="col-md-1">@Html.LabelFor(m => m.NewComponent.Seq_B)@Html.TextBoxFor(m => m.NewComponent.Seq_B, new { @class = "form-control form-control-sm" })</div>
                        <div class="col-md-1">@Html.LabelFor(m => m.NewComponent.BranchId)@Html.TextBoxFor(m => m.NewComponent.BranchId, new { @class = "form-control form-control-sm" })</div>

                        <div class="col-md-1 d-flex flex-column align-items-center">
                            <label class="form-switch-label" for="NewComponent_Active">Active</label>
                            <div class="form-check form-switch">
                                @Html.CheckBox("NewComponent.Active", Model.NewComponent.Active.GetValueOrDefault(false), new { @class = "form-check-input", id = "NewComponent_Active" })
                            </div>
                        </div>
                        <div class="col-md-1 d-flex flex-column align-items-center">
                            <label class="form-switch-label" for="NewComponent_Deleted">Deleted</label>
                            <div class="form-check form-switch">
                                @Html.CheckBox("NewComponent.Deleted", Model.NewComponent.Deleted.GetValueOrDefault(false), new { @class = "form-check-input", id = "NewComponent_Deleted" })
                            </div>
                        </div>
                        <div class="col-md-1 d-flex align-items-end justify-content-start">
                            <button type="submit" class="btn btn-primary btn-sm me-2">Save</button>
                            <a href="@Url.Action("Index","Gen_Components", new { showCreate = false, search = currentFilter })" class="btn btn-danger btn-sm">Cancel</a>
                        </div>
                    </div>
                }
            </div>
        </div>

    }

    <!-- INLINE EDIT -->
   @if (showEdit && editId.HasValue)
    {
        <div class="inline-card">
            <div class="row g-2 align-items-end">
               @using (Html.BeginForm("EditFromIndex", "Gen_Components", new { id = Model.EditComponent.Id, search = currentFilter }, FormMethod.Post, new { @class = "d-flex flex-nowrap align-items-end" }))
                {
                    @Html.AntiForgeryToken()
                    @Html.HiddenFor(m => m.EditComponent.Id)
                    <div class="row g-2">
                        <div class="col-md-1">
                            @Html.LabelFor(m => m.EditComponent.Code)
                            @Html.TextBoxFor(m => m.EditComponent.Code, new { @class = "form-control form-control-sm" })
                        </div>
                        <div class="col-md-1">
                            @Html.LabelFor(m => m.EditComponent.D_Code, "Design")
                            @Html.DropDownListFor(m => m.SelectedDesignId, (SelectList)ViewBag.DesignList, "-- select design --",
                            new { @class = "form-select form-select-sm" })
                        </div>
                        <div class="col-md-1">@Html.LabelFor(m => m.EditComponent.Name)@Html.TextBoxFor(m => m.EditComponent.Name, new { @class = "form-control form-control-sm" })</div>
                        <div class="col-md-1">@Html.LabelFor(m => m.EditComponent.HeadToHead)@Html.TextBoxFor(m => m.EditComponent.HeadToHead, new { @class = "form-control form-control-sm" })</div>
                        <div class="col-md-1">@Html.LabelFor(m => m.EditComponent.Stitch)@Html.TextBoxFor(m => m.EditComponent.Stitch, new { @class = "form-control form-control-sm" })</div>
                        <div class="col-md-1">@Html.LabelFor(m => m.EditComponent.Tilla)@Html.TextBoxFor(m => m.EditComponent.Tilla, new { @class = "form-control form-control-sm" })</div>
                        <div class="col-md-1">@Html.LabelFor(m => m.EditComponent.Seq_A)@Html.TextBoxFor(m => m.EditComponent.Seq_A, new { @class = "form-control form-control-sm" })</div>
                        <div class="col-md-1">@Html.LabelFor(m => m.EditComponent.Seq_B)@Html.TextBoxFor(m => m.EditComponent.Seq_B, new { @class = "form-control form-control-sm" })</div>
                        <div class="col-md-1">@Html.LabelFor(m => m.EditComponent.BranchId)@Html.TextBoxFor(m => m.EditComponent.BranchId, new { @class = "form-control form-control-sm" })</div>

                        <div class="col-md-1 d-flex flex-column align-items-center">
                            <label class="form-switch-label" for="NewComponent_Active">Active</label>
                            <div class="form-check form-switch">
                                @Html.CheckBox("EditComponent.Active", Model.EditComponent.Active.GetValueOrDefault(false), new { @class = "form-check-input", id = "EditComponent_Active" })
                            </div>
                        </div>
                        <div class="col-md-1 d-flex flex-column align-items-center">
                            <label class="form-switch-label" for="NewComponent_Deleted">Deleted</label>
                            <div class="form-check form-switch">
                                @Html.CheckBox("EditComponent.Deleted", Model.EditComponent.Deleted.GetValueOrDefault(false), new { @class = "form-check-input", id = "EditComponent_Deleted" })
                            </div>
                        </div>
                        <div class="col-md-1 d-flex align-items-end justify-content-start">
                            <button type="submit" class="btn btn-primary btn-sm me-2">Save</button>
                            <a href="@Url.Action("Index","Gen_Components", new { showCreate = false, search = currentFilter })" class="btn btn-danger btn-sm">Cancel</a>
                        </div>
                    </div>
                }
            </div>
        </div>

    }

    <!-- DATA GRID -->
    <div class="data-card table-responsive">
        <table class="table mb-0 align-middle">
            <thead>
                <tr>
                    <th>Code</th>
                    <th>D_Code</th>
                    <th>Name</th>
                    <th>HeadToHead</th>
                    <th>Stitch</th>
                    <th>Tilla</th>
                    <th>Seq A</th>
                    <th>Seq B</th>
                    <th>Branch</th>
                    <th>Active</th>
                    <th>Deleted</th>
                    <th class="text-center">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var comp in Model.Components)
                {
                <tr>
                    <td>@comp.Code</td>
                    <td>@comp.D_Code</td>
                    <td>@comp.Name</td>
                    <td>@comp.HeadToHead</td>
                    <td>@comp.Stitch</td>
                    <td>@comp.Tilla</td>
                    <td>@comp.Seq_A</td>
                    <td>@comp.Seq_B</td>
                    <td>@(comp.Branches?.Name ?? "—")</td>
                    <td><span class="badge @(comp.Active.GetValueOrDefault() ? "badge-active" : "badge-inactive")">@(comp.Active.GetValueOrDefault() ? "Yes" : "No")</span></td>
                    <td><span class="badge @(comp.Deleted.GetValueOrDefault() ? "badge-inactive" : "badge-active")">@(comp.Deleted.GetValueOrDefault() ? "Yes" : "No")</span></td>
                    <td class="text-center">
                        <a class="btn btn-sm btn-outline-primary me-1" href="@Url.Action("Index","Gen_Components", new { showEdit = true, editId = comp.Id, search = currentFilter })"><i class="bi bi-pencil"></i></a>
                        <a class="btn btn-sm btn-outline-danger me-1" href="@Url.Action("Delete","Gen_Components", new { id = comp.Id })"><i class="bi bi-trash"></i></a>
                        <a class="btn btn-sm btn-outline-info me-1" href="@Url.Action("Details","Gen_Components", new { id = comp.Id })"><i class="bi bi-info-circle"></i></a>
                    </td>
                </tr>
                }
            </tbody>
        </table>
    </div>

    <!-- PAGINATION -->
    <div class="d-flex justify-content-center mt-3">
        @Html.PagedListPager(
            Model.Components,
            page => Url.Action("Index", new { page, search = currentFilter, activeFilter }),
            new PagedListRenderOptions { UlElementClasses = new[] { "pagination" }, LiElementClasses = new[] { "page-item" } }
        )
    </div>
</div>

    @section Scripts {
        <script>
            $(function () {
                $('.data-card tbody tr').hover(
                    function () { $(this).addClass('table-active'); },
                    function () { $(this).removeClass('table-active'); }
                );
            });
        </script>
    }
