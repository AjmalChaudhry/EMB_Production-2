@model EMB_Production.Models.Gen_Stocks
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Delete Stock";
    var search = Request.QueryString["search"] ?? "";
    var activeFilter = Request.QueryString["activeFilter"] ?? "";
}

<style>
    .detail-card {
        background: #fff;
        border-left: 5px solid #dc3545;
        border-radius: 8px;
        padding: 1.5rem;
        box-shadow: 0 2px 12px rgba(0,0,0,0.1);
        margin-top: 1rem;
    }

    .details-header {
        font-size: 1.25rem;
        font-weight: 600;
        background: #dc3545;
        color: #fff;
        padding: .75rem 1rem;
        border-radius: 6px 6px 0 0;
        margin: -1.5rem -1.5rem 1rem;
    }

    .detail-label {
        font-weight: 600;
        font-size: .9rem;
        color: #2c3e50;
    }

    .detail-value {
        font-size: 1rem;
        color: #34495e;
        word-break: break-word;
    }
</style>

<div class="container-fluid py-4">
    <div class="detail-card">
        <div class="details-header">Confirm Delete Stock</div>
        <p class="text-danger fw-bold">Are you sure you want to delete this stock entry?</p>

        <div class="row gy-4">
            <div class="col-md-3">
                <div class="detail-label">Product</div>
                <div class="detail-value">@(Model.Gen_Products  != null? Model.Gen_Products.Prod_Name: "(none)")
                </div>
            </div>
            <div class="col-md-3">
                <div class="detail-label">Branch</div>
                <div class="detail-value">@(Model.Branches != null? Model.Branches.Name: "(none)")
                </div>
            </div>
            <div class="col-md-6">
                <div class="detail-label">Description</div>
                <div class="detail-value">@Model.StockDescription</div>
            </div>

            <div class="col-md-3">
                <div class="detail-label">In Stock</div>
                <div class="detail-value">@(Model.InStock==true?"✔":"")</div>
            </div>
            <div class="col-md-3">
                <div class="detail-label">New</div>
                <div class="detail-value">@(Model.New==true?"✔":"")</div>
            </div>
            <div class="col-md-3">
                <div class="detail-label">In</div>
                <div class="detail-value">@(Model.In==true?"✔":"")</div>
            </div>
            <div class="col-md-3">
                <div class="detail-label">Out</div>
                <div class="detail-value">@(Model.Out==true?"✔":"")</div>
            </div>

            <div class="col-md-3">
                <div class="detail-label">Rack</div>
                <div class="detail-value">@Model.Rack</div>
            </div>
            <div class="col-md-3">
                <div class="detail-label">Shelf</div>
                <div class="detail-value">@Model.Shelf</div>
            </div>
            <div class="col-md-3">
                <div class="detail-label">Measure Value</div>
                <div class="detail-value">@Model.MeasureValue</div>
            </div>
            <div class="col-md-3">
                <div class="detail-label">Total Stock</div>
                <div class="detail-value">@Model.TotalStock</div>
            </div>

            <div class="col-md-3">
                <div class="detail-label">Total Price</div>
                <div class="detail-value">@Model.TotalPrice</div>
            </div>
            <div class="col-md-3">
                <div class="detail-label">Bill Number</div>
                <div class="detail-value">@Model.BillNumber</div>
            </div>
            <div class="col-md-3">
                <div class="detail-label">Gate Pass</div>
                <div class="detail-value">@Model.GatePass</div>
            </div>
            <div class="col-md-3">
                <div class="detail-label">Record Timestamp</div>
                <div class="detail-value">
                    @(Model.RecordTimeStamp?.ToString("yyyy-MM-dd HH:mm:ss") ?? "(none)")
                </div>
            </div>

            <div class="col-md-3">
                <div class="detail-label">Active</div>
                <div class="detail-value">@(Model.Active==true?"Yes":"No")</div>
            </div>
            <div class="col-md-3">
                <div class="detail-label">Deleted</div>
                <div class="detail-value">@(Model.Deleted==true?"Yes":"No")</div>
            </div>
            <div class="col-md-3">
                <div class="detail-label">Created By</div>
                <div class="detail-value">@Model.CreatedBy</div>
            </div>
            <div class="col-md-3">
                <div class="detail-label">Created Date</div>
                <div class="detail-value">
                    @(Model.CreatedDate?.ToString("yyyy-MM-dd HH:mm:ss") ?? "(none)")
                </div>
            </div>

            <div class="col-md-3">
                <div class="detail-label">Updated By</div>
                <div class="detail-value">@Model.UpdatedBy</div>
            </div>
            <div class="col-md-3">
                <div class="detail-label">Updated Date</div>
                <div class="detail-value">
                    @(Model.UpdatedDate?.ToString("yyyy-MM-dd HH:mm:ss") ?? "(none)")
                </div>
            </div>
        </div>

        <div class="mt-4 text-center">
            @using (Html.BeginForm("DeleteConfirmed", "Gen_Stocks", FormMethod.Post))
            {
                @Html.AntiForgeryToken()
                @Html.HiddenFor(m => m.Id)
                <button type="submit" class="btn btn-danger me-3">
                    <i class="bi bi-trash-fill"></i> Yes, Delete
                </button>
                @Html.ActionLink("Cancel", "Index",
                   new { search = search, activeFilter = activeFilter },
                   new { @class = "btn btn-outline-secondary" })
            }
        </div>
    </div>
</div>
