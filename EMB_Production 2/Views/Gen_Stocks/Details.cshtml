@model EMB_Production.Models.Gen_Stocks

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Stock Details";
    var currentFilter = Request.QueryString["search"] ?? "";
    var activeFilter = Request.QueryString["activeFilter"] ?? "";
}

<style>
    .detail-card {
        background: #fff;
        border-left: 5px solid #007bff;
        border-radius: 8px;
        padding: 1.5rem;
        box-shadow: 0 2px 12px rgba(0,0,0,0.1);
        margin-top: 1rem;
    }

    .details-header {
        font-size: 1.25rem;
        font-weight: 600;
        background: #007bff;
        color: #fff;
        padding: 0.75rem 1rem;
        border-radius: 6px 6px 0 0;
        margin: -1.5rem -1.5rem 1rem;
    }

    .detail-label {
        font-weight: 600;
        font-size: 0.9rem;
        color: #2c3e50;
    }

    .detail-value {
        font-size: 1rem;
        color: #34495e;
        word-wrap: break-word;
    }
</style>

<div class="detail-card">
    <div class="details-header">Stock Details</div>

    <div class="toolbar-container d-flex align-items-center justify-content-end mb-3">
        @using (Html.BeginForm("Index", "Gen_Stocks", FormMethod.Get, new { @class = "d-flex align-items-center" }))
        {

            <button type="button" onclick="location.reload()"
                    class="btn btn-outline-secondary btn-sm me-2">
                <i class="bi bi-arrow-clockwise"></i>
            </button>
            <button type="button" onclick="window.print()"
                    class="btn btn-outline-secondary btn-sm me-2">
                <i class="bi bi-printer"></i>
            </button>
            <a class="btn btn-success btn-sm me-2"
               href="@Url.Action("ExportToExcel","Gen_JobOrders",
            new { id = Model.Id, search = "", activeFilter = "" })">
                <i class="bi bi-file-earmark-spreadsheet"></i> Excel
            </a>
            <a class="btn btn-danger btn-sm"
               href="@Url.Action("ExportToPdf","Gen_JobOrders",
            new { id = Model.Id, search = "", activeFilter = "" })">
                <i class="bi bi-file-earmark-pdf"></i> PDF
            </a>
        }
    </div>

    <div class="row gy-4">

        <!-- Product / Branch / Description -->
        <div class="row gy-4">
            <div class="col-md-3">
                <div class="detail-label">Product</div>
                <div class="detail-value">
                    @(Model.Gen_Products  != null
                        ? Model.Gen_Products.Prod_Name
                        : "(none)")
                </div>
            </div>
            <div class="col-md-3">
                <div class="detail-label">Branch</div>
                <div class="detail-value">
                    @(Model.Branches != null
                        ? Model.Branches.Name
                        : "(none)")
                </div>
            </div>
            <div class="col-md-6">
                <div class="detail-label">Description</div>
                <div class="detail-value">@Model.StockDescription</div>
            </div>
        </div>

        <!-- Record Timestamp -->
        <div class="col-md-3">
            <div class="detail-label">Record Timestamp</div>
            <div class="detail-value">
                @(Model.RecordTimeStamp.HasValue
                    ? Model.RecordTimeStamp.Value.ToString("yyyy-MM-dd HH:mm:ss")
                    : "(none)")
            </div>
        </div>

        @* now the rest of the scalar properties *@
       @foreach (var prop in ViewData.ModelMetadata.Properties
                             .Where(p => p.ShowForDisplay
                                      && p.PropertyName != nameof(Model.Gen_Products)
                                      && p.PropertyName != nameof(Model.Branches)
                                      && p.PropertyName != nameof(Model.StockDescription)
                                      && p.PropertyName != nameof(Model.RecordTimeStamp)))
        {
            <div class="col-md-3">
                <div class="detail-label">@prop.GetDisplayName()</div>
                <div class="detail-value">
                    @{
                        var val = prop.Model;
                        if (val is DateTime dt)
                        {
                            @dt.ToString("yyyy-MM-dd HH:mm")
                        }
                        else
                        {
                            @val
                        }
                    }
                </div>
            </div>
        }
    </div>

    <div class="mt-4 d-flex justify-content-center">
        @Html.ActionLink("Back to List", "Index", null, new { @class = "btn btn-outline-secondary me-3" })
        @Html.ActionLink("Edit", "Index", new { showEdit = true, editId = Model.Id }, new { @class = "btn btn-primary" })
    </div>
</div>
