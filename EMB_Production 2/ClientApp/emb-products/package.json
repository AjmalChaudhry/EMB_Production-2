{
  "name": "emb-products",
  "version": "1.0.0",
  "private": true,

  "scripts": {
    
    "ng": "ng",
    "start": "ng serve",
    
    "build": "ng build",
    "build:dev": "ng build --configuration development",
    "build:prod": "ng build --configuration production",
    
    "clean": "rmdir /s /q dist 2>nul || exit 0",
    
    "deploy:mvc": "if not exist dist\\emb-products\\index.html exit 1 && robocopy dist\\emb-products ..\\..\\Content\\emb-products /MIR /NFL /NDL /NJH /NJS /NP",
    
    "build:deploy": "npm run clean && npm run build:prod && npm run deploy:mvc",
    "deploy": "npm run build:deploy",
    
    "watch": "ng build --watch --configuration development",
    "test": "ng test"
  },

  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },

  "dependencies": {
    "@angular/animations": "^20.2.0",
    "@angular/cdk": "^20.2.0",
    "@angular/compiler": "^20.2.0",
    "@angular/forms": "^20.2.0",
    "@angular/material": "^20.2.0",
    "@angular/platform-browser": "^20.2.0",
    "@angular/router": "^20.2.0",

    "bootstrap": "^5.3.8",
    "bootstrap-icons": "^1.13.1",

    "file-saver": "^2.0.5",
    "jspdf": "^3.0.3",
    "jspdf-autotable": "^5.0.2",
    "xlsx": "^0.18.5",

    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.0"
  },

  "devDependencies": {
    "@angular-devkit/build-angular": "^20.2.0",
    "@angular/build": "^20.2.0",
    "@angular/cli": "^20.2.0",
    "@angular/common": "^20.2.0",
    "@angular/compiler-cli": "^20.2.0",
    "@angular/core": "^20.2.0",
    "@angular/platform-browser-dynamic": "^20.2.0",

    "@types/bootstrap": "^5.2.10",
    "@types/file-saver": "^2.0.7",
    "@types/jasmine": "~5.1.0",
    "@types/node": "^20.19.11",

    "jasmine-core": "~5.9.0",
    "jasmine-spec-reporter": "^7.0.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",

    "sass": "^1.91.0",
    "typescript": "^5.9.2"
  }
}
